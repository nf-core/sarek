def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'


nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test,gpu"

    def test_scenario = [
        [
            name: "-profile test,gpu --tools parabricks_haplotypecaller",
            params: [
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_single_bam.csv",
                tools: "parabricks_haplotypecaller",
                step: "variant_calling"
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --tools parabricks_haplotypecaller --no_intervals -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/mapped_single_bam.csv",
                tools: "parabricks_haplotypecaller",
                step: "variant_calling",
                no_intervals: true
            ],
            stub: true,
            no_conda: true
        ],
        [
            name: "-profile test --tools parabricks_haplotypecaller --skip_tools parabricks_haplotypecaller_filter -stub",
            params: [
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_single_bam.csv",
                tools: "parabricks_haplotypecaller",
                skip_tools: "parabricks_haplotypecaller_filter",
                step: "variant_calling"
            ],
            stub: true,
            no_conda: true
        ],
        [
            name: "-profile test,gpu --tools parabricks_haplotypecaller --joint_germline",
            params: [
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                tools: "parabricks_haplotypecaller",
                step: "variant_calling",
                joint_germline: true,
                dbsnp_vqsr: null,
                known_snps_vqsr: null,
                known_indels_vqsr: null,
                wes: true,
                nucleotides_per_second: 20
            ],
            gpu: true,
            no_conda: true
        ],
        [
            // Both callers reuse the GATK joint genotyping subworkflow and must publish to separate directories
            name: "-profile test --tools parabricks_haplotypecaller,haplotypecaller --joint_germline -stub",
            params: [
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                tools: "parabricks_haplotypecaller,haplotypecaller",
                step: "variant_calling",
                joint_germline: true,
                wes: true,
                nucleotides_per_second: 20
            ],
            stub: true,
            no_conda: true
        ],
        [
            name: "Fails with --no_intervals and --joint_germline for parabricks_haplotypecaller",
            params: [
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                tools: "parabricks_haplotypecaller",
                step: "variant_calling",
                joint_germline: true,
                no_intervals: true
            ],
            failure: true,
            snapshot: 'stderr,stdout',
            snapshot_include: 'requires intervals',
            no_conda: true
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
