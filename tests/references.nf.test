nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def references_datasheet = 'https://raw.githubusercontent.com/nf-core/references-datasheets/latest/genomes/Homo_sapiens/GATK/GRCh38_chr22.yml'

    def test_scenario = [
        [
            name: "-profile test --references genomes/Homo_sapiens/GATK/GRCh38_chr22.yml --genome null",
            params: [
                references: references_datasheet,
                genome: null,
            ],
            // The datasheet carries snpeff_db and vep_* keys that sarek does not map
            snapshot_ignore: ['unidentified headers'],
        ],
        [
            name: "-profile test --references genomes/Homo_sapiens/GATK/GRCh38_chr22.yml with --genome (expects failure)",
            params: [
                references: references_datasheet,
            ],
            failure: true,
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
