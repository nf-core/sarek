process {
    withName: 'GATK4_APPLYBQSR|GATK4SPARK_APPLYBQSR|DEEPVARIANT_RUNDEEPVARIANT' {
        // Stub scripts omit ext.args, so capture the evaluated configuration separately.
        afterScript = {
            def values = [task.process, meta.original_quality_scores ?: false, task.ext.args ?: '']
                .collect { value -> "'${value.toString().replace("'", "'\"'\"'")}'" }
                .join(' ')
            "printf '%s\\n' ${values} > quality_score_args.txt"
        }
    }
}
