process {
    withName: 'GATK4_APPLYBQSR|GATK4SPARK_APPLYBQSR|DEEPVARIANT_RUNDEEPVARIANT' {
        // Stub scripts omit ext.args, so capture the evaluated configuration separately.
        afterScript = {
            """\
            cat <<'NFTEST_QUALITY_SCORES' > quality_score_args.txt
            ${task.process}
            ${meta.original_quality_scores ?: false}
            ${task.ext.args ?: ''}
            NFTEST_QUALITY_SCORES
            """.stripIndent()
        }
    }
}
