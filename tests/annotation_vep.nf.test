def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "Fails with profile test --tools vep --vep_cache_version 1 --build_only_index",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                vep_cache_version: 1,
                input: null,
                build_only_index: true,
                tools: 'vep'
            ],
            failure: true,
            snapshot: 'stdout',
            snapshot_include: 'annotation-cache',
        ],
        [
            name: "Fails with profile test --dbnsfp and no dbnsfp_tbi",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                dbnsfp: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/dbsnp_138.hg38.vcf.gz',
                tools: 'vep'
            ],
            failure: true,
            snapshot: 'stdout',
            snapshot_include: 'dbnsfp inconsistency',
        ],
        [
            name: "-profile test --tools vep --vep_loftee",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                tools: 'vep',
                vep_loftee: true,
            ],
            vcf_header_check: '|LoF|',
        ],
        [
            name: "Fails when the LOFTEE GERP BigWig is missing",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                tools: 'vep',
                vep_loftee: true,
                vep_loftee_gerp_bigwig: "${projectDir}/tests/config/missing_loftee_gerp.bw",
            ],
            failure: true,
            tag: 'loftee_gerp',
            no_snapshot: true,
            check: { workflow, workDir ->
                assert workflow.stderr.join('\n').contains('missing_loftee_gerp.bw')
            },
        ],
        [
            name: "Fails when a LOFTEE GERP BigWig is supplied without LOFTEE",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                tools: 'vep',
                vep_loftee_gerp_bigwig: modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw',
            ],
            failure: true,
            tag: 'loftee_gerp',
            no_snapshot: true,
            check: { workflow, workDir ->
                assert workflow.stdout.join('\n').contains('--vep_loftee_gerp_bigwig requires --vep_loftee')
            },
        ],
        [
            name: "Stages a BigWig file and passes it to LOFTEE",
            params: [
                input: "${projectDir}/tests/csv/3.0/vcf_single.csv",
                step: 'annotate',
                tools: 'vep',
                vep_loftee: true,
                vep_loftee_gerp_bigwig: modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw',
            ],
            tag: 'loftee_gerp',
            no_snapshot: true,
            check: { workflow, workDir ->
                def vepCommands = []
                new File(workDir).eachFileRecurse { candidate ->
                    if (candidate.name == '.command.sh' && candidate.text.contains('vep \\')) {
                        vepCommands.add(candidate)
                    }
                }
                assert vepCommands.size() == 1
                assert vepCommands[0].text.contains('gerp_bigwig:test_S2.RPKM.bw')
                assert new File(vepCommands[0].parentFile, 'test_S2.RPKM.bw').exists()
            },
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
