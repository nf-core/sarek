def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test"

    def test_scenario = [
        [
            name: "-profile test --tools deepsomatic somatic WGS",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                step: "variant_calling",
                tools: 'deepsomatic'
            ],
            no_conda: true,
            no_vcf_md5sum: true
        ],
        [
            name: "-profile test --tools deepsomatic somatic WES",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                step: "variant_calling",
                tools: 'deepsomatic',
                wes: true
            ],
            no_conda: true,
            no_vcf_md5sum: true
        ],
        [
            name: "-profile test --tools deepsomatic somatic --no_intervals -stub",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                no_intervals: true,
                step: "variant_calling",
                tools: 'deepsomatic'
            ],
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --tools deepsomatic,strelka --filter_vcfs --normalize_vcfs --snv_consensus_calling",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                step: "variant_calling",
                tools: 'deepsomatic,strelka',
                wes: true,
                filter_vcfs: true,
                normalize_vcfs: true,
                snv_consensus_calling: true
            ],
            ignoreFiles: '**/consensus/**/{0000.vcf,0000.vcf.gz,sites.txt}',
            no_conda: true,
            no_vcf_md5sum: true
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
