def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test"

    def test_scenario = [
        [
            name: "-profile test --tools deepsomatic somatic WGS",
            tag: 'deepsomatic_wgs',
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: "${projectDir}/tests/bed/deepsomatic.bed",
                step: "variant_calling",
                tools: 'deepsomatic'
            ],
            no_conda: true,
            no_vcf_md5sum: true,
            vcf_samples: [pattern: 'variant_calling/deepsomatic/**/*.vcf.gz', names: ['tumour']]
        ],
        [
            name: "-profile test --tools deepsomatic somatic WES",
            tag: 'deepsomatic_wes',
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: "${projectDir}/tests/bed/deepsomatic.bed",
                step: "variant_calling",
                tools: 'deepsomatic',
                wes: true
            ],
            no_conda: true,
            no_vcf_md5sum: true,
            vcf_samples: [pattern: 'variant_calling/deepsomatic/**/*.vcf.gz', names: ['tumour']]
        ],
        [
            name: "-profile test --tools deepsomatic somatic scatter/gather",
            tag: 'deepsomatic_scatter',
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/mapped_somatic_parabricks_deepsomatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                nucleotides_per_second: 1,
                step: "variant_calling",
                tools: 'deepsomatic'
            ],
            no_conda: true,
            no_vcf_md5sum: true,
            vcf_samples: [pattern: 'variant_calling/deepsomatic/**/*.vcf.gz', names: ['testT']],
            assertions: { workflow, outdir, workDir ->
                assert workflow.trace.succeeded().count { it.name.contains(':DEEPSOMATIC (') } == 2
                assert workflow.trace.succeeded().count { it.name.contains(':MERGE_DEEPSOMATIC_VCF (') } == 1
                assert workflow.trace.succeeded().count { it.name.contains(':MERGE_DEEPSOMATIC_GVCF (') } == 1
                def published = new File("${outdir}/variant_calling/deepsomatic/testT_vs_testN").listFiles()*.name.sort()
                assert published == ['testT_vs_testN.deepsomatic.g.vcf.gz', 'testT_vs_testN.deepsomatic.g.vcf.gz.tbi', 'testT_vs_testN.deepsomatic.vcf.gz', 'testT_vs_testN.deepsomatic.vcf.gz.tbi']
                def shardNames = [] as Set
                new File(workDir.toString()).eachFileRecurse { file ->
                    if (file.name.startsWith('testT_vs_testN.deepsomatic.chr22_') && file.name.endsWith('.vcf.gz')) {
                        shardNames.add(file.name)
                    }
                }
                assert shardNames.count { name -> name.endsWith('.g.vcf.gz') } == 2
                assert shardNames.count { name -> !name.endsWith('.g.vcf.gz') } == 2
            }
        ],
        [
            name: "-profile test --tools deepsomatic somatic --no_intervals -stub",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: "${projectDir}/tests/bed/deepsomatic.bed",
                no_intervals: true,
                step: "variant_calling",
                tools: 'deepsomatic'
            ],
            no_conda: true,
            stub: true,
            config: "${projectDir}/tests/config/deepsomatic_stub.config",
            tag: 'cpu'
        ],
        [
            name: "-profile test --tools deepsomatic,strelka --filter_vcfs --normalize_vcfs --snv_consensus_calling",
            tag: 'deepsomatic_postprocessing',
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: "${projectDir}/tests/bed/deepsomatic.bed",
                step: "variant_calling",
                tools: 'deepsomatic,strelka',
                wes: true,
                filter_vcfs: true,
                normalize_vcfs: true,
                snv_consensus_calling: true
            ],
            ignoreFiles: '**/consensus/**/{0000.vcf,0000.vcf.gz,sites.txt}',
            no_conda: true,
            no_vcf_md5sum: true,
            vcf_samples: [pattern: 'variant_calling/deepsomatic/**/*.vcf.gz', names: ['tumour']]
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
