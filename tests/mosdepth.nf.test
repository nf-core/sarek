def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test --step markduplicates --tools null --skip_tools baserecalibrator,markduplicates,fastqc,samtools,multiqc --mosdepth_no_fast_mode",
            params: [
                input: "${projectDir}/tests/csv/3.0/mapped_single_bam.csv",
                step: 'markduplicates',
                tools: null,
                skip_tools: 'baserecalibrator,markduplicates,fastqc,samtools,multiqc',
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                mosdepth_no_fast_mode: true
            ],
            tag: 'mosdepth'
        ],
        [
            name: "-profile test --step markduplicates --tools null --skip_tools baserecalibrator,markduplicates,fastqc,samtools,multiqc --wes --mosdepth_no_fast_mode",
            params: [
                input: "${projectDir}/tests/csv/3.0/mapped_single_bam.csv",
                step: 'markduplicates',
                tools: null,
                skip_tools: 'baserecalibrator,markduplicates,fastqc,samtools,multiqc',
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                wes: true,
                mosdepth_no_fast_mode: true
            ],
            tag: 'mosdepth'
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
