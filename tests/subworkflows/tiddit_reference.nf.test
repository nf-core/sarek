nextflow_workflow {
    name "TIDDIT shared reference"
    script "../../subworkflows/local/bam_variant_calling_single_tiddit/main.nf"
    workflow "BAM_VARIANT_CALLING_SINGLE_TIDDIT"
    config "./reference_reuse.config"
    options "-stub-run"
    tag "stub"
    tag "cpu"
    tag "reference_reuse"

    [1, 3, 0].each { sampleCount ->
        test("TIDDIT reuses its reference for ${sampleCount} germline samples") {
            when {
                workflow {
                    """
                    def samples = ${sampleCount} ? (1..${sampleCount}).collect { i ->
                        def id = 'p' + i
                        def bam = file(id + '.bam')
                        bam.text = 'synthetic'
                        [[id: id, patient: id], bam, []]
                    } : []
                    file('reference.fa').text = '>ref\\nACGT\\n'
                    file('reference.fa.fai').text = 'ref\\t4\\t5\\t4\\t5\\n'
                    input[0] = channel.fromList(samples)
                    input[1] = channel.fromPath('reference.fa').map { fa -> [[id: 'ref'], fa] }.collect()
                    input[2] = channel.fromPath('reference.fa.fai').map { fai -> [[id: 'ref'], fai] }.collect()
                    input[3] = channel.value([[id: 'bwa'], []])
                    """
                }
            }
            then {
                assert workflow.success
                def ids = sampleCount ? (1..sampleCount).collect { i -> 'p' + i } : []
                assert workflow.out.vcf.collect { row -> row[0].id }.sort() == ids
                assert workflow.out.tbi.collect { row -> row[0].id }.sort() == ids
                assert workflow.out.ploidy.collect { row -> row[0].id }.sort() == ids
                assert workflow.out.vcf.every { row ->
                    row.size() == 2 && row[0].patient == row[0].id && row[0].variantcaller == 'tiddit' && path(row[1]).fileName.toString().startsWith(row[0].id + '.') && path(row[1]).fileName.toString().endsWith('.vcf.gz')
                }
                assert workflow.trace.succeeded().findAll { task -> task.name.contains(':TIDDIT_SV') }.size() == sampleCount
            }
        }
    }
}
