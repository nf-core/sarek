nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test",
            params: [],
        ],
        [
            name: "-profile test -stub",
            params: [],
            stub: true,
        ],
        [
            name: "-profile test --intervals genome.multi_intervals.bed --nucleotides_per_second 20 --skip_tools fastqc,mosdepth,multiqc,samtools",
            params: [
                intervals: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.multi_intervals.bed',
                nucleotides_per_second: 20,
                skip_tools: 'fastqc,mosdepth,multiqc,samtools',
            ],
            tag: 'cram_merge',
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
