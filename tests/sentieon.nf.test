def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test sentieon"
    script "../main.nf"

    def test_scenario = [
        [
            name: "-profile test --aligner sentieon-bwamem --tools null -stub",
            params: [
                aligner: "sentieon-bwamem",
                tools: ''
            ],
            stub: true,
            sentieon: true
        ],
        [
            name: "-profile test --tools sentieon_dnascope,sentieon_haplotyper --joint_germline -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/mapped_joint_bam.csv",
                step: "variant_calling",
                tools: 'sentieon_dnascope,sentieon_haplotyper',
                joint_germline: true,
                sentieon_dnascope_emit_mode: 'gvcf',
                sentieon_haplotyper_emit_mode: 'gvcf',
                dbsnp_vqsr: null,
                known_snps_vqsr: null,
                known_indels_vqsr: null
            ],
            stub: true,
            sentieon: true
        ]
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
