def projectDir = new File('.').absolutePath
def modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    profile "test,gpu"

    // The "from cram input" scenarios below intentionally have no real (non-stub) variant.
    // recalibrated_somatic.csv points at generic, shared test-datasets CRAM fixtures whose
    // @RG SM: tags are hardcoded to "normal"/"tumour" and don't follow sarek's
    // ${meta.patient}_${meta.sample} naming convention. Parabricks mutectcaller requires
    // --tumor-name/--normal-name to exactly match the CRAM's SM: tag, so a real run against
    // these fixtures always fails with "Invalid tumor/normal sample name" regardless of how
    // ext.args builds the name. Real (non-stub) GPU coverage instead comes from the
    // fastq_pair.csv-based scenarios below, where sarek's own alignment step writes the RG SM
    // tag itself and it naturally matches. sentieon_tnscope (conf/modules/sentieon_tnscope.config),
    // which has the same exact-match requirement, follows the same pattern.
    def test_scenario = [
        [
            name: "-profile test --step variant_calling --tools parabricks_mutectcaller from cram input -stub",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                intervals: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                step: "variant_calling",
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --step variant_calling --tools parabricks_mutectcaller --no_intervals from cram input -stub",
            params: [
                genome: null,
                igenomes_ignore: true,
                fasta: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta',
                fasta_fai: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai',
                input: "${projectDir}/tests/csv/3.0/recalibrated_somatic.csv",
                no_intervals: true,
                step: "variant_calling",
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --aligner parabricks --tools parabricks_mutectcaller",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                aligner: 'parabricks',
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --aligner parabricks --tools parabricks_mutectcaller -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                aligner: 'parabricks',
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --aligner parabricks --tools parabricks_mutectcaller --no_intervals",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                aligner: 'parabricks',
                tools: 'parabricks_mutectcaller',
                no_intervals: true,
                wes: true
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --aligner parabricks --tools parabricks_mutectcaller --no_intervals -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                aligner: 'parabricks',
                tools: 'parabricks_mutectcaller',
                no_intervals: true,
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller --no_intervals",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                tools: 'parabricks_mutectcaller',
                no_intervals: true,
                wes: true
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller --no_intervals -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                tools: 'parabricks_mutectcaller',
                no_intervals: true,
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller with pon",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                pon: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/mills_and_1000G.indels.hg38.vcf.gz',
                pon_tbi: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/mills_and_1000G.indels.hg38.vcf.gz.tbi',
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true
        ],
        [
            name: "-profile test --tools parabricks_mutectcaller with pon -stub",
            params: [
                input: "${projectDir}/tests/csv/3.0/fastq_pair.csv",
                pon: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/mills_and_1000G.indels.hg38.vcf.gz',
                pon_tbi: modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/germlineresources/mills_and_1000G.indels.hg38.vcf.gz.tbi',
                tools: 'parabricks_mutectcaller',
                wes: true
            ],
            gpu: true,
            no_conda: true,
            stub: true
        ]
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
