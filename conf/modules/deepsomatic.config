/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'DEEPSOMATIC' {
        ext.args = {[
            params.wes ? "--model_type=WES" : "--model_type=WGS",
            // run_deepsomatic does not forward --sample_name_tumor to postprocess_variants, which falls back to "default" for intervals without any records (contigs DeepVariant excludes, such as *_alt or chrEBV, or contigs missing from the BAM header)
            meta.tumor_id ? "--sample_name_tumor ${meta.patient}_${meta.tumor_id} --postprocess_variants_extra_args sample_name=${meta.patient}_${meta.tumor_id}" : "",
            meta.normal_id ? "--sample_name_normal ${meta.patient}_${meta.normal_id}" : "",
        ].join(" ").trim()}
        ext.prefix = { meta.num_intervals <= 1 ? "${meta.id}.deepsomatic" : "${meta.id}.deepsomatic.${intervals.baseName}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/" },
            pattern: "*{vcf.gz,vcf.gz.tbi}",
            saveAs: { filename -> meta.num_intervals > 1 ? null : "deepsomatic/${meta.id}/${filename}" }
        ]
    }

    withName: 'MERGE_DEEPSOMATIC_VCF' {
        ext.prefix = { "${meta.id}.deepsomatic" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/deepsomatic/${meta.id}/" },
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: 'MERGE_DEEPSOMATIC_GVCF' {
        ext.prefix = { "${meta.id}.deepsomatic.g" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/deepsomatic/${meta.id}/" },
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }

}
