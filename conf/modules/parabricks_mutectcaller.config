/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// PARABRICKS MUTECTCALLER

process {

    withName: 'PARABRICKS_MUTECTCALLER' {
        ext.args   = { [
            "--tumor-name ${meta.patient}_${meta.tumor_id ?: meta.sample}",
            meta.normal_id ? "--normal-name ${meta.patient}_${meta.normal_id}" : '',
            "--mutect-f1r2-tar-gz ${task.ext.prefix}.f1r2.tar.gz",
        ].join(' ').trim() }

        ext.prefix = { "${meta.id}.parabricks_mutectcaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*{vcf.gz,vcf.gz.tbi,vcf.gz.stats}"
        ]
    }

    // The MUTECTCALLER_* aliases below are not prefixed PARABRICKS_, so the GPU resources in test_full.config do not apply
    withName: 'MUTECTCALLER_GETPILEUPSUMMARIES.*' {
        ext.prefix = { "${meta.id}.parabricks_mutectcaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*.table"
        ]
    }

    withName: 'MUTECTCALLER_CALCULATECONTAMINATION' {
        ext.args   = { "-tumor-segmentation ${meta.id}.parabricks_mutectcaller.segmentation.table" }
        ext.prefix = { "${meta.id}.parabricks_mutectcaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*.table"
        ]
    }

    withName: 'MUTECTCALLER_LEARNREADORIENTATIONMODEL' {
        ext.prefix = { "${meta.id}.parabricks_mutectcaller.artifactprior" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*.artifactprior.tar.gz"
        ]
    }

    withName: 'MUTECTCALLER_FILTERMUTECTCALLS' {
        ext.prefix = { "${meta.id}.parabricks_mutectcaller.filtered" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*{vcf.gz,vcf.gz.tbi,filteringStats.tsv}"
        ]
    }

}
