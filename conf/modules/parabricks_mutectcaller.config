/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When to run the module.
----------------------------------------------------------------------------------------
*/

// PARABRICKS MUTECTCALLER

process {

    withName: 'PARABRICKS_MUTECTCALLER' {
        ext.args   = { [
            "--tumor-name ${meta.patient}_${meta.tumor_id ?: meta.sample}",
            meta.normal_id ? "--normal-name ${meta.patient}_${meta.normal_id}" : '',
        ].join(' ').trim() }

        // No ext.prefix: the module default (${meta.id}) is intended. It must differ from the
        // TABIX_PARABRICKS_MUTECTCALLER prefix, which links the VCF under its final, caller-tagged name;
        // a shared prefix would make the tabix output the same file as its staged input.
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*.vcf.gz.stats",
            saveAs: { _filename -> "${meta.id}.parabricks_mutectcaller.vcf.gz.stats" }
        ]
    }

    // The Parabricks VCF is already bgzip-compressed: this only links and indexes it (no re-compression)
    // and publishes the raw calls with their index
    withName: 'TABIX_PARABRICKS_MUTECTCALLER' {
        ext.prefix = { "${meta.id}.parabricks_mutectcaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_mutectcaller/${meta.id}" },
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }

}
