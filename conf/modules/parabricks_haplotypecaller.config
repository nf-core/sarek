/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        ext.when   = When to run the module.
----------------------------------------------------------------------------------------
*/

// PARABRICKS HAPLOTYPECALLER

process {

    withName: 'PARABRICKS_HAPLOTYPECALLER' {
        // Suffixed with "_raw" so the gVCF output (already bgzipped by pbrun when run with
        // ext.args = '--gvcf') never shares its filename with the downstream
        // TABIX_BGZIPTABIX_GVCF output of the same prefix/extension.
        ext.prefix = { "${meta.id}.parabricks_haplotypecaller_raw" }
        // pbrun only accepts a fixed set of GATK options, and only through --haplotypecaller-options.
        // The annotation groups match GATK HaplotypeCaller's defaults, which VQSR relies on.
        ext.args   = { [
            params.joint_germline       ? "--gvcf"                                                                       : "",
            "-G StandardAnnotation -G StandardHCAnnotation",
            params.gatk_pcr_indel_model ? "--haplotypecaller-options \"-pcr-indel-model ${params.gatk_pcr_indel_model}\"" : "",
        ].join(" ").trim() }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'PARABRICKS_DBSNP' {
        // pbrun dbsnp runs on CPU only and rejects the --num-gpus flag the module adds when an accelerator is set
        accelerator = null
        ext.prefix = { "${meta.id}.parabricks_haplotypecaller_dbsnp" }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'NFCORE_SAREK:SAREK:BAM_VARIANT_CALLING_GERMLINE_ALL:BAM_VARIANT_CALLING_PARABRICKS_HAPLOTYPECALLER:TABIX_BGZIPTABIX_(VCF|GVCF)' {
        ext.prefix = { "${meta.id}.parabricks_haplotypecaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_haplotypecaller/${meta.id}/" },
            // Matches both the VCF (*.vcf.gz) and gVCF (*.g.vcf.gz) outputs, since only one of
            // TABIX_BGZIPTABIX_VCF/TABIX_BGZIPTABIX_GVCF runs per invocation.
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }

    withName: '.*:PARABRICKS_HAPLOTYPECALLER_VCF_VARIANT_FILTERING_GATK:FILTERVARIANTTRANCHES' {
        ext.args   = { "--info-key CNN_1D" }
        ext.prefix = { "${meta.id}.parabricks_haplotypecaller" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/variant_calling/parabricks_haplotypecaller/${meta.id}/" },
            pattern: "*{vcf.gz,vcf.gz.tbi}"
        ]
    }

}
