/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
 */

// PARABRICKS DEEPVARIANT

process {

    withName: PARABRICKS_DEEPVARIANT {
        // When using WES mode, pass --disable-small-model in addition to --use-wes-model to obtain behavior consistent with Google DeepVariant.
        ext.args = { params.wes ? "--use-wes-model --disable-small-model" : "" }
        // Keep staged input distinct from the downstream compression output.
        ext.prefix = { "${meta.id}.parabricks_deepvariant_raw" }
        publishDir = [mode: params.publish_dir_mode, path: { "${params.outdir}/variant_calling/parabricks_deepvariant/${meta.id}/" }, pattern: "*.vcf.gz", saveAs: { filename ->
            filename.endsWith('.g.vcf.gz')
                ? "${meta.id}.parabricks_deepvariant.g.vcf.gz"
                : "${meta.id}.parabricks_deepvariant.vcf.gz"
        }]
    }

    withName: TABIX_VC_PARABRICKS_DEEPVARIANT {
        ext.prefix = { "${meta.id}.parabricks_deepvariant" }
        publishDir = [mode: params.publish_dir_mode, path: { "${params.outdir}/variant_calling/parabricks_deepvariant/${meta.id}/" }, pattern: "*.tbi"]
    }
}
