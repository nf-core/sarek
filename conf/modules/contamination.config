process {
    // Contaminant removal options
    withName: 'BBMAP_BBSPLIT' {
        ext.args   = 'build=1 ambiguous2=best maxindel=150000'
        ext.prefix = { params.split_fastq && reads ? "${reads[0].getName().tokenize('.')[0]}.${meta.id}" : "${meta.id}" }

        // Single publishDir map with saveAs-based routing: a closure nested inside a
        // publishDir list breaks `nextflow config -o json` (used by nf-core lint).
        publishDir = [
            path: { "${params.outdir}/preprocessing/bbsplit/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.endsWith('.txt')) {
                    return filename
                }
                if (filename.endsWith('.fastq.gz')) {
                    return params.save_bbsplit_reads ? filename : null
                }
                return null
            }
        ]
    }
}
