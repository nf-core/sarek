{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/sarek/dev/assets/schema_references.json",
    "title": "nf-core/sarek references datasheet schema",
    "description": "Datasheet schema for sarek: genome plus optional reference files, indices, VQSR labels, and annotation metadata",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "genome": {
                "meta": ["genome"],
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Genome name must be provided and cannot contain spaces"
            },
            "site": {
                "meta": ["site"],
                "type": "string",
                "pattern": "^\\S+$",
                "default": "unknown"
            },
            "source": {
                "meta": ["source"],
                "type": "string",
                "pattern": "^\\S+$"
            },
            "source_version": {
                "meta": ["source_version"],
                "type": "string",
                "pattern": "^\\S+$",
                "default": "unknown"
            },
            "species": {
                "meta": ["species"],
                "type": "string",
                "pattern": "^\\S+$"
            },
            "ascat_alleles": {
                "meta": ["ascat_alleles"],
                "type": "string",
                "pattern": "^\\S+\\.zip$"
            },
            "ascat_genome": {
                "meta": ["ascat_genome"],
                "type": "string",
                "enum": ["hg19", "hg38"]
            },
            "ascat_loci": {
                "meta": ["ascat_loci"],
                "type": "string",
                "pattern": "^\\S+\\.zip$"
            },
            "ascat_loci_gc": {
                "meta": ["ascat_loci_gc"],
                "type": "string",
                "pattern": "^\\S+\\.zip$"
            },
            "ascat_loci_rt": {
                "meta": ["ascat_loci_rt"],
                "type": "string",
                "pattern": "^\\S+\\.zip$"
            },
            "bwa": {
                "meta": ["bwa"],
                "type": "string"
            },
            "bwamem2": {
                "meta": ["bwamem2"],
                "type": "string"
            },
            "cf_chrom_len": {
                "meta": ["cf_chrom_len"],
                "type": "string"
            },
            "chr_dir": {
                "meta": ["chr_dir"],
                "type": "string"
            },
            "dbsnp": {
                "meta": ["dbsnp"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz$"
            },
            "dbsnp_tbi": {
                "meta": ["dbsnp_tbi"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz\\.tbi$"
            },
            "dbsnp_vqsr": {
                "meta": ["dbsnp_vqsr"],
                "type": "string"
            },
            "dict": {
                "meta": ["dict"],
                "type": "string",
                "pattern": "^\\S+\\.dict$"
            },
            "dragmap": {
                "meta": ["dragmap"],
                "type": "string"
            },
            "fasta": {
                "meta": ["fasta"],
                "type": "string",
                "pattern": "^\\S+\\.fn?a(sta)?(\\.gz)?$",
                "errorMessage": "Fasta must end in '.fa', '.fna', or '.fasta' (optionally .gz) and cannot contain spaces"
            },
            "fasta_fai": {
                "meta": ["fasta_fai"],
                "type": "string",
                "pattern": "^\\S+\\.f(ast|n)?a\\.fai(\\.gz)?$",
                "errorMessage": "Fasta index must end in '.fa.fai', '.fna.fai', or '.fasta.fai' (optionally .gz) and cannot contain spaces"
            },
            "germline_resource": {
                "meta": ["germline_resource"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz$"
            },
            "germline_resource_tbi": {
                "meta": ["germline_resource_tbi"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz\\.tbi$"
            },
            "intervals": {
                "meta": ["intervals"],
                "type": "string"
            },
            "known_indels": {
                "meta": ["known_indels"],
                "type": ["string", "array"],
                "items": {
                    "type": "string",
                    "pattern": "^\\S+\\.vcf\\.gz$"
                }
            },
            "known_indels_tbi": {
                "meta": ["known_indels_tbi"],
                "type": ["string", "array"],
                "items": {
                    "type": "string",
                    "pattern": "^\\S+\\.vcf\\.gz\\.tbi$"
                }
            },
            "known_indels_vqsr": {
                "meta": ["known_indels_vqsr"],
                "type": "string"
            },
            "known_snps": {
                "meta": ["known_snps"],
                "type": ["string", "array"],
                "items": {
                    "type": "string",
                    "pattern": "^\\S+\\.vcf\\.gz$"
                }
            },
            "known_snps_tbi": {
                "meta": ["known_snps_tbi"],
                "type": ["string", "array"],
                "items": {
                    "type": "string",
                    "pattern": "^\\S+\\.vcf\\.gz\\.tbi$"
                }
            },
            "known_snps_vqsr": {
                "meta": ["known_snps_vqsr"],
                "type": "string"
            },
            "mappability": {
                "meta": ["mappability"],
                "type": "string",
                "pattern": "^\\S+\\.gem$"
            },
            "msisensor2_models": {
                "meta": ["msisensor2_models"],
                "type": "string"
            },
            "msisensorpro_scan": {
                "meta": ["msisensorpro_scan"],
                "type": "string"
            },
            "ngscheckmate_bed": {
                "meta": ["ngscheckmate_bed"],
                "type": "string",
                "pattern": "^\\S+\\.bed$"
            },
            "pon": {
                "meta": ["pon"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz$"
            },
            "pon_tbi": {
                "meta": ["pon_tbi"],
                "type": "string",
                "pattern": "^\\S+\\.vcf\\.gz\\.tbi$"
            },
            "sentieon_dnascope_model": {
                "meta": ["sentieon_dnascope_model"],
                "type": "string",
                "pattern": "^\\S+\\.model$"
            },
            "snpeff_db": {
                "meta": ["snpeff_db"],
                "type": "string"
            },
            "vep_cache_version": {
                "meta": ["vep_cache_version"],
                "type": "string"
            },
            "vep_genome": {
                "meta": ["vep_genome"],
                "type": "string"
            },
            "vep_species": {
                "meta": ["vep_species"],
                "type": "string"
            },
            "readme": {
                "meta": ["readme"],
                "type": "string",
                "pattern": "^\\S+\\.(md|txt)$"
            }
        },
        "required": ["genome"]
    }
}
