params {
    xengsort_nobjects = 400000
    xengsort_kmersize = 25
}

process {
    withName: 'PREPARE_GENOME:BBMAP_BBSPLIT' {
        memory = '1.GB'
    }

    withName: 'PREPARE_GENOME:XENGSORT_INDEX' {
        memory = '8.GB'
        ext.args = { "--kmersize ${params.xengsort_kmersize}" }
        ext.prefix = 'index'
    }
}
